{
  "name": "speaking-practice",
  "private": true,
  "version": "1.0.0",
  "description": "Two-user spoken English practice app on Cloudflare Pages, D1, and Workers AI.",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:init": "wrangler d1 execute speaking_practice_db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute speaking_practice_db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}